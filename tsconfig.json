{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "./test/scratch/toolchain/node_modules/@types"
    ],
    "paths": {
      "react": [
        "./test/scratch/toolchain/node_modules/@types/react",
        "./node_modules/@types/react"
      ],
      "react-dom/client": [
        "./test/scratch/toolchain/node_modules/@types/react-dom/client",
        "./node_modules/@types/react-dom/client"
      ],
      "react/*": [
        "./test/scratch/toolchain/node_modules/@types/react/*",
        "./node_modules/@types/react/*"
      ],
      "vite": [
        "./test/scratch/toolchain/node_modules/vite/dist/node/index.d.ts",
        "./node_modules/vite/dist/node/index.d.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
